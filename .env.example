# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# ── Paddle (billing) ───────────────────────────────────────
NEXT_PUBLIC_PADDLE_ENV=production                 # 'sandbox' or 'production'
PADDLE_ENV=production                             # used by the cancel route
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-client-token
PADDLE_API_KEY=your-paddle-api-key               # server-only (cancel route)
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret # server-only (signature verification)

# Subscription price IDs
NEXT_PUBLIC_PADDLE_PRO_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRO_YEARLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_BUSINESS_PRICE_ID=
NEXT_PUBLIC_PADDLE_BUSINESS_YEARLY_PRICE_ID=

# Credit-pack price IDs
NEXT_PUBLIC_PADDLE_STARTER_PRICE_ID=
NEXT_PUBLIC_PADDLE_PRO_PACK_PRICE_ID=
NEXT_PUBLIC_PADDLE_BUSINESS_PACK_PRICE_ID=

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key

# ── Cron ───────────────────────────────────────────────────
CRON_SECRET=a-long-random-string                 # Bearer token for /api/cron/reminders
